{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NCZ Group",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Company",
            "pages": [
              "api-reference/company/get"
            ]
          },
          {
            "group": "Suppliers",
            "pages": [
              "api-reference/suppliers/list",
              "api-reference/suppliers/get",
              "api-reference/suppliers/compliance"
            ]
          },
          {
            "group": "Webinars",
            "pages": [
              "api-reference/webinars/list",
              "api-reference/webinars/get",
              "api-reference/webinars/registrations"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "description": "OpenAPI-compliant documentation for interacting with your data at NCZ Group.",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ]
    },
    "mdx": {
      "auth": {
        "method": "key",
        "name": "x-api-key"
      },
      "server": "https://api.nczgroup.com"
    }
  }
}
