{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NCZ Group",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "banner": {
    "content": "**⚠️ Heads up:** Our API is currently in active development. Endpoints may change.",
    "type": "warning",
    "dismissible": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Company",
            "pages": ["api-reference/company/get"]
          },
          {
            "group": "Suppliers",
            "pages": [
              "api-reference/suppliers/list",
              "api-reference/suppliers/get",
              "api-reference/suppliers/compliance"
            ]
          },
          {
            "group": "Webinars",
            "pages": [
              "api-reference/webinars/list",
              "api-reference/webinars/get",
              "api-reference/webinars/registrations"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "https://nczgroup.com/contact",
        "label": "Contact us"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Log in",
      "href": "https://portal.nczgroup.com/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/neutralcarbonzone",
      "instagram": "https://www.instagram.com/neutral_carbon_zone",
      "website": "https://nczgroup.com"
    }
  },
  "description": "Developer documentation for the NCZ Customer API.",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "javascript", "python"]
    },
    "mdx": {
      "auth": {
        "method": "key",
        "name": "x-api-key"
      },
      "server": "https://api.nczgroup.com"
    }
  }
}
